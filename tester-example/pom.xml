<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.resys-io</groupId>
    <artifactId>resys-orw-jsp</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>resys-orw-jsp-tester-example</artifactId>
  <name>OpenRewrite JSP tester example</name>
  <description>An example web application tested with the tester (not published).</description>

  <properties>
    <!-- An example and testbed, not a library: never published (see also the root release profile). -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <!--
    A small Struts 1 style web application (src/main/webapp) whose pages are tested with the tester
    (src/test): real JSTL and Struts bean/logic tags, Struts html tags mocked (they need a running
    ActionServlet), and an in-house tag library with no implementation, mocked automatically.
  -->

  <dependencies>
    <!--
      What the application itself uses: Struts 1 on Jakarta EE (weblegacy's continuation of Apache
      Struts 1, same org.apache.struts packages), and JSTL 2.0, which still declares the
      http://java.sun.com/jsp/jstl/* taglib uris (JSTL 3.0 renamed them to jakarta.tags.*).
    -->
    <dependency>
      <groupId>io.github.weblegacy</groupId>
      <artifactId>struts-taglib</artifactId>
      <version>1.5.0-RC2</version>
    </dependency>
    <dependency>
      <groupId>org.glassfish.web</groupId>
      <artifactId>jakarta.servlet.jsp.jstl</artifactId>
      <version>2.0.0</version>
      <exclusions>
        <!--
          jakarta.servlet.jsp.jstl-api 2.0.0 declares these at compile scope; the container provides
          them (in tests, Tomcat 10.1's newer versions, which these older JARs would shadow).
        -->
        <exclusion>
          <groupId>jakarta.servlet</groupId>
          <artifactId>jakarta.servlet-api</artifactId>
        </exclusion>
        <exclusion>
          <groupId>jakarta.el</groupId>
          <artifactId>jakarta.el-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>io.github.resys-io</groupId>
      <artifactId>resys-orw-jsp-tester</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
