<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts-config PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 1.3//EN"
        "http://struts.apache.org/dtds/struts-config_1_3.dtd">
<struts-config>
    <form-beans>
        <form-bean name="searchForm" type="org.apache.struts.action.DynaActionForm">
            <form-property name="q" type="java.lang.String"/>
        </form-bean>
    </form-beans>
    <action-mappings>
        <action path="/orders/search" name="searchForm" scope="request"
                type="org.apache.struts.actions.ForwardAction" parameter="/WEB-INF/views/orders.jsp"/>
    </action-mappings>
    <message-resources parameter="com.acme.shop.MessageResources"/>
</struts-config>
